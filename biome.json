{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/out",
      "!**/.vite",
      "!**/coverage",
      "!**/bun.lock",
      "!**/bun.lockb",
      "!plans",
      "!packages/ui/src/i18n/i18n-types.ts",
      "!packages/ui/src/i18n/i18n-util.ts",
      "!packages/ui/src/i18n/i18n-util.sync.ts",
      "!packages/ui/src/i18n/i18n-util.async.ts",
      "!packages/ui/src/i18n/i18n-react.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/**/*.tsx", "packages/desktop/src/renderer/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/i18n/t",
                      "**/i18n/t.js",
                      "**/i18n",
                      "**/i18n/index",
                      "**/i18n/index.js",
                      "@pi-deck/ui/i18n"
                    ],
                    "importNamePattern": "(ll|llFor|currentLocale)",
                    "message": "A .tsx that reads translations imperatively renders correctly once and then goes stale on a language switch, because reading the store creates no subscription. Use `const { LL, locale } = useI18nContext()` instead. See AGENTS.md, Localization (i18n)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
