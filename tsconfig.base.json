{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["node"],
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // typesafe-i18n generates its util files with explicit ".ts" import specifiers
    // (outputFormat is TypeScript). Every tsconfig here is noEmit and both bundlers (Vite,
    // electron-vite) resolve .ts directly, so allowing them costs nothing.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@pi-deck/core": ["./packages/core/src/index.ts"],
      "@pi-deck/core/*": ["./packages/core/src/*"],
      "@pi-deck/ui": ["./packages/ui/src/index.ts"],
      "@pi-deck/ui/*": ["./packages/ui/src/*"],
      "@pi-deck/desktop/*": ["./packages/desktop/src/*"]
    }
  }
}
